{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sop-better.local/schemas/manifest.schema.json",
  "title": "sop-better generation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sop_version",
    "profile_schema_version",
    "rules_version",
    "standard",
    "slots",
    "components",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sop_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_schema_version": {"const": 1},
    "rules_version": {"type": "string", "minLength": 1},
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/slot"}
    },
    "components": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/component"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    }
  },
  "$defs": {
    "condition": {
      "enum": ["always", "collaborators", "multiend", "parallel", "serial", "collaborators_or_parallel"]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "required", "format"],
      "properties": {
        "type": {"enum": ["string", "string_list"]},
        "source": {"type": "string", "pattern": "^/"},
        "required": {"type": "boolean"},
        "format": {"enum": ["inline", "lines"]}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "rule_ids", "slots", "references"],
      "properties": {
        "template": {"type": "string", "minLength": 1},
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "uniqueItems": true
        },
        "slots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "component_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "when": {"$ref": "#/$defs/condition"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "when", "management", "components"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "when": {"$ref": "#/$defs/condition"},
        "for_each": {"enum": ["ends"]},
        "management": {"const": "block"},
        "marker_style": {"enum": ["html", "hash"]},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component_ref"}
        }
      }
    }
  }
}
