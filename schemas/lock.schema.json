{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sop-better.local/schemas/lock.schema.json",
  "title": "sop-better render lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sop_version", "generator_version", "rules_version", "profile_hash", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "sop_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generator_version": {"type": "string", "minLength": 1},
    "rules_version": {"type": "string", "minLength": 1},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/output"}
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "management", "components", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "management": {"const": "block"},
        "marker_style": {"enum": ["html", "hash"]},
        "components": {"type": "array", "items": {"type": "string"}},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
