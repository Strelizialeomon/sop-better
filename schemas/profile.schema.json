{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sop-better.local/schemas/profile.schema.json",
  "title": "sop-better project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sop_version", "project", "ends", "humans", "parallel_agents", "risk", "house_style"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "sop_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_branch", "sop_initialized_on"],
      "properties": {
        "name": {"allOf": [{"$ref": "#/$defs/portable_text"}, {"minLength": 1}]},
        "description": {"$ref": "#/$defs/portable_text"},
        "default_branch": {"allOf": [{"$ref": "#/$defs/portable_text"}, {"minLength": 1}]},
        "sop_initialized_on": {"type": "string", "format": "date"}
      }
    },
    "ends": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/end"}
    },
    "humans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/human"}
    },
    "parallel_agents": {"type": "boolean"},
    "risk": {"enum": ["reversible", "controlled", "high"]},
    "house_style": {"type": "array", "items": {"$ref": "#/$defs/portable_text"}},
    "risk_items": {"type": "array", "items": {"$ref": "#/$defs/portable_text"}},
    "prod_infra_note": {"$ref": "#/$defs/portable_text"},
    "runtime": {"$ref": "#/$defs/runtime"}
  },
  "allOf": [
    {
      "if": {"properties": {"parallel_agents": {"const": true}}, "required": ["parallel_agents"]},
      "then": {"properties": {"ends": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
      "then": {
        "required": ["runtime"],
        "properties": {
          "ends": {"maxItems": 1},
          "parallel_agents": {"const": false},
          "risk": {"const": "reversible"}
        }
      },
      "else": {"not": {"required": ["runtime"]}}
    }
  ],
  "$defs": {
    "portable_text": {
      "type": "string",
      "pattern": "^(?!\\s*(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\))(?!.*(?:[\\s\"'(=])(?:/(?:Users|home|var|etc|opt|tmp|private|Volumes|mnt|srv|root)(?:/|[\\s\"')]|$)|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\\\s]+\\\\[^\\\\\\s]+)).*$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\\\)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[<>:\"|?*]).+$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tracker", "start_mode", "auto_merge", "evidence_trust", "lease_timeout_seconds", "heartbeat_interval_seconds", "trust", "checks"],
      "properties": {
        "mode": {"const": "loop-v1-experimental"},
        "tracker": {"const": "github"},
        "start_mode": {"const": "manual"},
        "auto_merge": {"const": "disabled"},
        "evidence_trust": {"const": "cooperative-local"},
        "lease_timeout_seconds": {"type": "integer", "minimum": 1},
        "heartbeat_interval_seconds": {"type": "integer", "minimum": 1},
        "trust": {"$ref": "#/$defs/runtime_trust"},
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}
          }
        }
      }
    },
    "runtime_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trusted_actor_ids"],
          "properties": {
            "trusted_actor_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
          }
        }
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "display_name": {"$ref": "#/$defs/portable_text"},
        "path": {"$ref": "#/$defs/repository_path"},
        "stack": {"$ref": "#/$defs/portable_text"},
        "docs": {"type": "array", "items": {"$ref": "#/$defs/repository_path"}},
        "implementation_vocabulary": {"type": "array", "items": {"$ref": "#/$defs/portable_text"}},
        "milestones": {"type": "array", "items": {"$ref": "#/$defs/portable_text"}},
        "high_risk_items": {"type": "array", "items": {"$ref": "#/$defs/portable_text"}}
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roles"],
      "properties": {
        "id": {"allOf": [{"$ref": "#/$defs/portable_text"}, {"minLength": 1}]},
        "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/portable_text"}, "uniqueItems": true}
      }
    }
  }
}
